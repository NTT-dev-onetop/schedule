rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isClassMember(classId) {
      return signedIn()
        && myUser().data.classIds is list
        && classId in myUser().data.classIds;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.classIds is list
        && request.resource.data.activeClassId is string
        && (request.resource.data.activeClassId == ''
            || request.resource.data.activeClassId in request.resource.data.classIds);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // MULTI-CLASS: every class has an isolated schedule namespace.
    match /classes/{classId}/schedules/{weekKey} {
      allow read, create, update, delete: if isClassMember(classId);
    }

    // MULTI-CLASS: every class has an isolated task namespace.
    match /classes/{classId}/tasks/{taskId} {
      allow read: if isClassMember(classId);
      allow create: if isClassMember(classId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isClassMember(classId);
      allow delete: if isClassMember(classId)
        && resource.data.createdBy == request.auth.uid;
    }

    // No legacy top-level /schedules or /tasks access.
    match /schedules/{weekId} {
      allow read, write: if false;
    }

    match /tasks/{taskId} {
      allow read, write: if false;
    }

    match /rankings/{weekId} {
      allow read, write: if false;
    }
  }
}
